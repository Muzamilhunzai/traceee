# ---- TraceNet Server ----
PORT=5000
NODE_ENV=development

# JWT signing secret — CHANGE THIS IN PRODUCTION
JWT_SECRET=tracenet-super-secret-change-me-in-production-2025
JWT_EXPIRES_IN=7d

# CORS origin (frontend)
CLIENT_ORIGIN=http://localhost:5173

# Password hashing rounds
BCRYPT_ROUNDS=10

# Demo credentials for seeded users (informational only)
# admin@tracenet.local      / Admin123!
# detective@tracenet.local  / Detective123!